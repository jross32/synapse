{
    "name": "synapse-premium-setup",
    "version": "0.2.219",
    "lockfileVersion": 3,
    "requires": true,
    "description": "Synapse premium setup frontend",
    "main": "host-chatgpt.cjs",
    "private": true,
    "packages": {
        "": {
            "name": "synapse-premium-setup",
            "version": "0.2.219"
        }
    },
    "build": {
        "appId": "com.whatif.synapse.premiumsetup",
        "asar": true,
        "electronVersion": "31.7.7",
        "extraResources": [
            {
                "from": "payload/Synapse Setup 0.1.209.exe",
                "to": "synapse-payload/Synapse Setup 0.1.209.exe"
            }
        ],
        "files": [
            "index.html",
            "installer.css",
            "installer.js",
            "native-adapter-chatgpt.js",
            "host-chatgpt.cjs",
            "preload-chatgpt.cjs",
            "assets/**/*",
            "payload-manifest.json",
            "premium-polish.css"
        ],
        "productName": "Synapse Premium Setup",
        "directories": {
            "output": "../../release-premium-shell"
        },
        "win": {
            "icon": "../../electron/icons/synapse.ico",
            "signAndEditExecutable": false,
            "target": "portable"
        }
    },
    "scripts": {
        "preview": "node serve.cjs",
        "test": "node scripts/capture-screenshots.js"
    }
}
