# EditorConfig — https://editorconfig.org
# Mirrors the CLAUDE.md style config + the actual codebase (2-space JS/TS, 4-space Python).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false   # trailing spaces can be significant (hard line breaks)

[Makefile]
indent_style = tab

[*.{ps1,cmd,bat}]
end_of_line = crlf
