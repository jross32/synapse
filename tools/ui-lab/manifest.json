{
  "id": "ui-lab",
  "name": "Synapse UI Lab",
  "category": "dev-tools",
  "icon": "wrench",
  "description": "Run screenshot, layout, accessibility smoke, and optional browser flow tests. Save responsive HTML and JSON evidence. Native iOS Safari remains unverified without a real-device provider.",
  "version": "0.2.1",
  "publisher": "The WhatIf Company",
  "verified": false,
  "bundled": true,
  "install_default": true,
  "fields": [
    {
      "key": "target",
      "type": "text",
      "label": "Project URL",
      "required": true,
      "placeholder": "http://127.0.0.1:5173",
      "help": "Use the reachable URL of a running web application. The runner cannot verify private auth on its own."
    },
    {
      "key": "engine",
      "type": "text",
      "label": "Browser engine",
      "required": false,
      "default": "chromium",
      "help": "chromium, firefox, or webkit; none prove native iPhone Safari."
    },
    {
      "key": "profile",
      "type": "text",
      "label": "Device profile",
      "required": false,
      "default": "iphone-compact",
      "help": "iphone-compact, iphone-large, tablet-portrait, desktop"
    }
  ],
  "actions": [
    {
      "id": "verify",
      "label": "Verify UI viewport",
      "primitive": "process.spawn",
      "params": {
        "argv": [
          "C:\\Users\\justi\\synapse\\.venv\\Scripts\\python.exe",
          "C:\\Users\\justi\\synapse\\tools\\ui_lab_matrix.py",
          "{target}",
          "--engine",
          "{engine}",
          "--profile",
          "{profile}",
          "--output",
          "C:\\Users\\justi\\synapse\\artifacts\\ui-lab-tool"
        ],
        "timeout": 30,
        "cwd": "C:\\Users\\justi\\synapse"
      },
      "primary": true,
      "scope": "tool"
    }
  ]
}
