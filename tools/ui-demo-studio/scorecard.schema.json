{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.local/ui-demo-studio/scorecard.schema.json",
  "title": "UI Demo Studio Scorecard",
  "type": "object",
  "required": [
    "version",
    "experience_mode",
    "overall_score",
    "grade",
    "scores",
    "gates",
    "metrics",
    "raw"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "experience_mode": {
      "type": "string",
      "enum": [
        "app"
      ]
    },
    "validity": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "mismatch",
            "not_applicable"
          ]
        },
        "expected": {
          "type": [
            "string",
            "null"
          ]
        },
        "detected": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_titles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "benchmark_context": {
      "type": "object",
      "properties": {
        "scorecard_version": {
          "type": "string"
        },
        "target_url": {
          "type": "string"
        },
        "target_input": {
          "type": "string"
        },
        "journey_mode": {
          "type": "string"
        },
        "journey": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewport": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "overall_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F",
        "N/A"
      ]
    },
    "scores": {
      "type": "object",
      "required": [
        "ui",
        "ux",
        "performance",
        "accessibility",
        "reliability"
      ],
      "properties": {
        "ui": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ux": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "performance": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "accessibility": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "reliability": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "overall_coverage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "dimensions": {
          "type": "object"
        },
        "unmeasured_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_applicable_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "effect",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "ui",
        "ux",
        "performance",
        "accessibility",
        "reliability"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "label",
            "score",
            "observed",
            "target",
            "source"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "status": {
              "type": "string",
              "enum": [
                "measured",
                "partial",
                "not_measured",
                "not_applicable"
              ]
            },
            "observed": {},
            "target": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "raw": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
