{
  "manifest_version": 3,
  "name": "Synapse ChatGPT Presence",
  "version": "0.1.0",
  "description": "Read-only local presence/timing observer for ChatGPT tabs. Reports only to Synapse on 127.0.0.1.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:7878/*",
    "http://localhost:7878/*"
  ],
  "background": {"service_worker": "service-worker.js"},
  "content_scripts": [
    {"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}
  ],
  "action": {"default_title": "Synapse ChatGPT Presence"}
}