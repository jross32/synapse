{
  "manifest_version": 3,
  "name": "Synapse ChatGPT Presence",
  "version": "0.3.0",
  "description": "Automatically groups ChatGPT Synapse workers, counts open and active workers, and shows an in-tab activity notice.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:7878/*",
    "http://localhost:7878/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Synapse Workers — open/active count"
  }
}