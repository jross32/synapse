daemon/auth-token
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db

# Electron-builder output
release/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Secrets / local
*.local.json
secrets/

# Runtime artifacts (per-process, never committed)
*.pid
.playwright-mcp/
installer/daemon-dist/
*.exe

# Agent-operating-brief drops at repo root. PROMPT.md is a reserved daemon-generated
# runtime filename (routes_quick_actions/routes_benchmarks/tools/fast_money write it into a
# spawned session's project cwd) -- it must never be committed as source at the repo root.
/PROMPT.md
/IMPROVEMENT-BRIEF.md

# Test / agent scratch (per-run, never committed)
.tmp/
.codex-e2e-logs/
discover-*.png
sweep-*.jpg
pytest-full.txt
pytest*.txt
data-pwatest/
installer/build-temp/
ollamabuild/
synapse.lnk
icon-check.*
icon-preview.*
benchmarks/app-build/*/trailmark.db

# Scratch workspaces and per-run test files from the build probes. The test that decided a
# piece's verdict is recorded in build_result.json (PieceOutcome.test_source), so the loose
# copies are regenerated noise rather than evidence.
benchmarks/app-build/probe-storage*/
benchmarks/app-build/*/_test_*.py
benchmarks/app-build/*/_check_*.py
benchmarks/app-build/*/_scenario_*.py

# Per-arm workspaces from the ladder/Phase C/Phase D benchmark scripts (phase_c_batch.py,
# prove_ladder_rungs.py, prove_fallback.py, delegate_*.py, bench.py) -- each arm's generated
# module + db + __pycache__ lands in its own directory here. The finding is what's committed
# (PHASE_C_RESULTS.md, phase_d_result.json, CHANGELOG.md); these are the raw scratch behind
# it and were piling up untracked instead of being ignored.
benchmarks/app-build/ladder-*/
benchmarks/app-build/phase-c-*/
benchmarks/app-build/delegated/
benchmarks/delegation/ws-*/
benchmarks/delegation/delegated/

# save_blueprint() writes to blueprints_dir()/<id>/blueprint.json; a bare root-level copy is
# always a stray from an ad-hoc script run with the wrong cwd/root, never source.
/blueprint.json
